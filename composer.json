{
    "name": "pollora/option",
    "description": "A modern PHP package for WordPress option management with validation and immutable value objects",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.6",
        "laravel/pint": "^v1.22.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^v3.8.2",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Option\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Option\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:coverage": "pest --coverage",
        "test:unit": "pest --testsuite=Unit",
        "phpstan": "phpstan analyse src tests --level=5",
        "phpstan:ci": "phpstan analyse src tests --level=5 --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
